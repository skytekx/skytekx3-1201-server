#!/usr/bin/env bash
# Control the SkyTekx3 server on macOS.
#   macos/skytekx3ctl status          launchd state, online players, tick times
#   macos/skytekx3ctl start           enable and load the launchd job (sudo)
#   macos/skytekx3ctl stop            stop the server cleanly, it stays down across reboots until start (sudo)
#   macos/skytekx3ctl restart         RCON "stop", launchd starts the server again right away
#   macos/skytekx3ctl rcon <command>  run one console command over RCON
#   macos/skytekx3ctl log             follow logs/latest.log
#   macos/skytekx3ctl backup          run the world backup now
set -euo pipefail
DIR="$(cd "$(dirname "$0")/.." && pwd)"
LABEL=com.skytekx.server
PLIST=/Library/LaunchDaemons/$LABEL.plist

prop() { sed -n "s/^$1=//p" "$DIR/server.properties" | tr -d '\r'; }
rcon() { /usr/bin/python3 "$DIR/tools/rcon.py" 127.0.0.1 "$(prop rcon.port)" "$(prop rcon.password)" "$@"; }

case "${1:-status}" in
  start)
    # stop disables the job. Enable it again, or the bootstrap fails and the next boot skips it too.
    sudo launchctl enable system/$LABEL
    sudo launchctl bootstrap system "$PLIST" 2>/dev/null || sudo launchctl kickstart system/$LABEL ;;
  stop)
    # disable keeps launchd from loading the job at the next boot, so the server stays down until
    # "start", also when the power fails in the middle of a restore or a world wipe.
    # bootout sends SIGTERM, which ServerMac.sh turns into an RCON "stop", and returns before the job
    # has exited. Wait until the JVM is gone and launchd has removed the job, so "start" can load it.
    sudo launchctl disable system/$LABEL
    sudo launchctl bootout system/$LABEL 2>/dev/null || true
    for _ in $(seq 1 100); do
      if ! pgrep -f 'java .*arclight[.]jar nogui' >/dev/null && ! launchctl print system/$LABEL >/dev/null 2>&1; then
        echo "Server stopped. It stays down, also across reboots, until: macos/skytekx3ctl start"
        exit 0
      fi
      sleep 2
    done
    echo "The server is still running after 200 s, see logs/latest.log"
    exit 1 ;;
  restart)
    rcon stop ;;
  status)
    launchctl print system/$LABEL 2>/dev/null | grep -E '^\s*(state|pid|runs|last exit code) =' || echo "launchd job not loaded"
    case "$(launchctl print-disabled system 2>/dev/null || true)" in
      *"\"$LABEL\" => disabled"*) echo "launchd job disabled by stop, the server stays down across reboots until start" ;;
    esac
    rcon list 2>/dev/null || echo "RCON not answering (server booting or stopped)"
    rcon "forge tps" 2>/dev/null | tail -n 3 || true ;;
  rcon)
    shift
    rcon "$@" ;;
  log)
    tail -n 50 -f "$DIR/logs/latest.log" ;;
  backup)
    "$DIR/macos/backup.sh" ;;
  *)
    sed -n '/^set /q;2,$p' "$0"   # The comment block at the top, up to the "set" line
    exit 2 ;;
esac
