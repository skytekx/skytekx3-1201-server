<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Keeps RCON (TCP 65535) reachable from loopback only, the macOS counterpart of the ufw rule on Linux.
  Minecraft binds RCON to server-ip (0.0.0.0), and the macOS application firewall cannot filter by port,
  so pf does it. At boot this loads /etc/pf.anchors/com.skytekx (installed root owned by macos/install.sh
  from macos/pf-rcon-guard.conf) into the com.apple/250.skytekx anchor and enables pf.
  It runs as root and calls only /sbin/pfctl with root owned files, no script from the server directory.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.skytekx.rcon-guard</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>-c</string>
    <string>/sbin/pfctl -q -a com.apple/250.skytekx -f /etc/pf.anchors/com.skytekx &amp;&amp; /sbin/pfctl -E</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/dev/null</string>
  <key>StandardErrorPath</key>
  <string>/var/log/com.skytekx.rcon-guard.log</string>
</dict>
</plist>
